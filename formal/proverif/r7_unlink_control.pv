(* Round 7 B2.1 control: the current fixed-id design. The vehicle id is sent in clear (as node_id is in the alert today), together with the boot counter and the counter, which are also in clear. Same test as r7_unlink.pv:
   two alerts of the same vehicle (left) against two alerts of two vehicles (right). The unlinkability equivalence must FAIL here. *)
free c: channel.
const tagA: bitstring.
const tagE: bitstring.
const tagACK: bitstring.
const mAlert: bitstring.
const mAck: bitstring.
fun kdf(bitstring, bitstring): bitstring.
fun mac(bitstring, bitstring): bitstring.
fun senc(bitstring, bitstring, bitstring): bitstring.
reduc forall k: bitstring, n: bitstring, m: bitstring; sdec(k, n, senc(k, n, m)) = m.
table seen(bitstring, bitstring, bitstring).

let Alert(master: bitstring, v: bitstring) =
  new boot: bitstring; new ctr: bitstring; new payload: bitstring;
  let kv = kdf(master, v) in
  let ct = senc(kdf(kv, tagE), (boot, ctr), payload) in
  out(c, (mAlert, v, boot, ctr, ct, mac(kv, (tagA, v, boot, ctr, ct)))).

let Base(master: bitstring) =
  in(c, (=mAlert, v: bitstring, b: bitstring, k: bitstring, ct: bitstring, t: bitstring));
  let kv = kdf(master, v) in
  if t = mac(kv, (tagA, v, b, k, ct)) then
  get seen(=v, =b, =k) in 0 else
  ( insert seen(v, b, k); out(c, (mAck, v, mac(kv, (tagACK, v)))) ).

process
  new master: bitstring; new idA: bitstring; new idB: bitstring;
  ( !Base(master) | Alert(master, idA) | Alert(master, choice[idA, idB]) )
